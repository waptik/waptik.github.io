---
import { SITE, AUTHOR, OG } from "../config";
import Seo, { type Props as SeoProps } from "./Seo.astro";

export interface ArticleMeta {
  publishedTime: string;
  modifiedTime?: string;
  tags: string[];
}

export interface Props {
  title: string;
  description: string;
  permalink?: string;
  ogImage?: string;
  article?: ArticleMeta;
  seo?: Partial<SeoProps>;
}

const { title, description, permalink, ogImage, article, seo } = Astro.props;

const canonical = permalink
  ? new URL(permalink, Astro.site ?? SITE.url)
  : new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const image = new URL(ogImage ?? SITE.defaultOgImage, Astro.site ?? SITE.url);

const person = {
  "@type": "Person",
  name: AUTHOR.name,
  url: AUTHOR.url,
};

const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      url: canonical.href,
      image: image.href,
      datePublished: article.publishedTime,
      dateModified: article.modifiedTime ?? article.publishedTime,
      keywords: article.tags?.join(", "),
      inLanguage: SITE.lang,
      author: person,
      publisher: person,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      description: SITE.description,
      url: SITE.url,
      inLanguage: SITE.lang,
      author: person,
    };

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const formattedTitle = isHome
  ? `${SITE.title} — ${SITE.tagline}`
  : title.endsWith(`- ${SITE.title}`) || title.includes(`— ${SITE.title}`)
    ? title
    : title === SITE.title
      ? `${SITE.title} — ${SITE.tagline}`
      : `${title} - ${SITE.title}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Favicons & App Manifest -->
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Font Preloads -->
<link
  rel="preload"
  href="/fonts/merriweather-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/fira-sans-bold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.title} — ${SITE.tagline}`}
  href={new URL("rss.xml", Astro.site ?? SITE.url).href}
/>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Theme Color -->
<meta
  name="theme-color"
  content="#ffffff"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0f172a"
  media="(prefers-color-scheme: dark)"
/>

<!-- SEO: Managed via modular Seo.astro component -->
<Seo
  title={formattedTitle}
  description={description}
  canonical={canonical}
  openGraph={{
    title: formattedTitle,
    description,
    type: article ? "article" : "website",
    url: canonical,
    siteName: SITE.title,
    locale: SITE.locale,
    image: {
      url: image.href,
      alt: formattedTitle,
      width: OG.width,
      height: OG.height,
    },
    article: article
      ? {
          publishedTime: article.publishedTime,
          modifiedTime: article.modifiedTime,
          authors: [AUTHOR.name],
          tags: article.tags,
        }
      : undefined,
    ...seo?.openGraph,
  }}
  twitter={{
    card: "summary_large_image",
    site: AUTHOR.twitter,
    creator: AUTHOR.twitter,
    title: formattedTitle,
    description,
    image: image.href,
    imageAlt: formattedTitle,
    url: canonical,
    ...seo?.twitter,
  }}
  jsonLd={seo?.jsonLd ?? structuredData}
  additionalMetaTags={[
    { name: "author", content: AUTHOR.name },
    ...(seo?.additionalMetaTags ?? []),
  ]}
  additionalLinkTags={seo?.additionalLinkTags}
  {...seo}
/>

<!-- Theme initialization script (anti-FOUC) -->
<script is:inline>
  const root = document.documentElement;
  const theme = localStorage.getItem("theme");
  if (
    theme === "dark" ||
    (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    root.classList.add("theme-dark");
    root.setAttribute("data-pf-theme", "dark");
  } else {
    root.classList.remove("theme-dark");
    root.removeAttribute("data-pf-theme");
  }
</script>
