---
import { AUTHOR } from "../config";
import SocialLinks from "./SocialLinks.astro";
---

<div
  class="my-8 p-6 rounded-2xl border border-border bg-border/5 flex flex-col sm:flex-row gap-5 items-center sm:items-start text-center sm:text-left"
>
  <img
    src={AUTHOR.avatar}
    alt={AUTHOR.name}
    width="64"
    height="64"
    loading="lazy"
    decoding="async"
    class="w-16 h-16 rounded-full object-cover shrink-0 ring-2 ring-primary/40 -rotate-3 hover:rotate-0 transition-transform duration-300"
  />
  <div class="flex-1 min-w-0">
    <div class="font-sans font-bold text-base text-text-main mb-1">
      Written by {AUTHOR.name}
    </div>
    <p class="text-xs sm:text-sm text-text-secondary leading-relaxed m-0 mb-3">
      {AUTHOR.bio}
    </p>
    <div
      class="flex items-center justify-center sm:justify-start gap-3 text-xs font-sans flex-wrap"
    >
      <a
        href="/about"
        class="text-primary hover:underline font-semibold no-underline mr-1"
      >
        About me &rarr;
      </a>
      <SocialLinks layout="horizontal" iconSize={16} />
    </div>
  </div>
</div>
