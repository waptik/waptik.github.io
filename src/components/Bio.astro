---
import { AUTHOR, SOCIAL } from "../config";
---

<div class="items-center flex">
  <img
    src={AUTHOR.avatar}
    alt={AUTHOR.name}
    class="w-[100px] h-[100px] rounded-full block mr-5 object-cover object-top aspect-square"
  />
  <p class="text-lg">
    Hi, I'm <strong>{AUTHOR.name}</strong>. {AUTHOR.bio}
    You can follow me on {
      SOCIAL.map((social, i) => (
        <span>
          <a href={social.href} target="_blank">
            {social.label}
          </a>
          {i < SOCIAL.length - 1 && <span>, </span>}
        </span>
      ))
    }.
  </p>
</div>
