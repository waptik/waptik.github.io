---
import { SITE } from "../config";
import { LogomarkIcon } from "./icons";
---

<a
  href="/"
  class="group flex items-center gap-2 font-sans font-bold text-lg text-text-main hover:text-primary transition-all duration-500 no-underline shrink-0 rounded-lg hover:scale-[101%] active:scale-[99%]"
  aria-label={`${SITE.title} Home`}
>
  <LogomarkIcon
    size={34}
    class="-rotate-12 group-hover:-rotate-3 transition-transform duration-500 ease-out"
  />
  <span class="inline-block text-base tracking-tight font-bold">
    {SITE.title}
  </span>
</a>
