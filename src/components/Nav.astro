---
import { NAV } from "../config";

export interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
---

<nav
  class="flex items-center gap-1 sm:gap-3 mt-3 sm:mt-4 overflow-x-auto no-scrollbar py-1 w-full"
  aria-label="Main Navigation"
>
  {
    NAV.map((item) => {
      const isSelected =
        (item.href === "/" && (current === "" || current === "home")) ||
        (item.href !== "/" &&
          (current === item.href.replace(/^\//, "") ||
            current.startsWith(item.href.replace(/^\//, "") + "/")));
      return (
        <a
          href={item.href}
          class:list={[
            "text-xs uppercase tracking-wide transition-all relative px-2.5 py-1 rounded-full font-sans font-semibold shrink-0 no-underline",
            isSelected
              ? "text-text-main bg-border/60 font-bold"
              : "text-text-secondary hover:text-text-main hover:bg-border/30",
          ]}
          aria-current={isSelected ? "page" : undefined}
        >
          <span class="relative">{item.label}</span>
        </a>
      );
    })
  }
</nav>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>

