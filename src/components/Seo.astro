---
export interface MetaTag {
  name?: string;
  property?: string;
  httpEquiv?: string;
  content: string;
}

export interface LinkTag {
  rel: string;
  href: string;
  sizes?: string;
  type?: string;
  hreflang?: string;
  as?: string;
  crossorigin?: string;
  media?: string;
  title?: string;
  [key: string]: string | undefined;
}

export interface OpenGraphMedia {
  url: string;
  alt?: string;
  width?: number | string;
  height?: number | string;
  type?: string;
  secureUrl?: string;
}

export interface OpenGraphArticle {
  publishedTime?: string;
  modifiedTime?: string;
  expirationTime?: string;
  authors?: string[];
  section?: string;
  tags?: string[];
}

export interface OpenGraph {
  title?: string;
  description?: string;
  type?: string;
  url?: string | URL;
  image?: string | OpenGraphMedia;
  images?: Array<string | OpenGraphMedia>;
  siteName?: string;
  locale?: string;
  alternateLocales?: string[];
  article?: OpenGraphArticle;
}

export interface Twitter {
  card?: "summary" | "summary_large_image" | "app" | "player";
  site?: string;
  creator?: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string | URL;
}

export interface Robots {
  index?: boolean;
  follow?: boolean;
  noarchive?: boolean;
  nosnippet?: boolean;
  noimageindex?: boolean;
  nocache?: boolean;
  notranslate?: boolean;
  maxSnippet?: number;
  maxImagePreview?: "none" | "standard" | "large";
  maxVideoPreview?: number;
}

export type JsonLd = Record<string, unknown> | Array<Record<string, unknown>>;

export interface Props {
  title?: string;
  titleTemplate?: string;
  titleDefault?: string;
  description?: string;
  canonical?: string | URL;
  noindex?: boolean;
  nofollow?: boolean;
  robots?: Robots;
  openGraph?: OpenGraph;
  twitter?: Twitter;
  jsonLd?: JsonLd;
  additionalMetaTags?: MetaTag[];
  additionalLinkTags?: LinkTag[];
}

const {
  title,
  titleTemplate,
  titleDefault = "",
  description,
  canonical,
  noindex,
  nofollow,
  robots,
  openGraph,
  twitter,
  jsonLd,
  additionalMetaTags = [],
  additionalLinkTags = [],
} = Astro.props;

// Determine final title
const computedTitle = title
  ? titleTemplate
    ? titleTemplate.replace("%s", title)
    : title
  : titleDefault;

// Build meta tags list
const metaTags: MetaTag[] = [];

if (computedTitle) {
  metaTags.push({ name: "title", content: computedTitle });
}

if (description) {
  metaTags.push({ name: "description", content: description });
}

// Robots directives
const robotDirectives: string[] = [];
const shouldIndex =
  robots?.index !== undefined
    ? robots.index
    : noindex !== undefined
      ? !noindex
      : undefined;
const shouldFollow =
  robots?.follow !== undefined
    ? robots.follow
    : nofollow !== undefined
      ? !nofollow
      : undefined;

if (shouldIndex !== undefined) {
  robotDirectives.push(shouldIndex ? "index" : "noindex");
}
if (shouldFollow !== undefined) {
  robotDirectives.push(shouldFollow ? "follow" : "nofollow");
}
if (robots?.noarchive) robotDirectives.push("noarchive");
if (robots?.nosnippet) robotDirectives.push("nosnippet");
if (robots?.noimageindex) robotDirectives.push("noimageindex");
if (robots?.nocache) robotDirectives.push("nocache");
if (robots?.notranslate) robotDirectives.push("notranslate");
if (robots?.maxSnippet !== undefined) {
  robotDirectives.push(`max-snippet:${robots.maxSnippet}`);
}
if (robots?.maxImagePreview) {
  robotDirectives.push(`max-image-preview:${robots.maxImagePreview}`);
}
if (robots?.maxVideoPreview !== undefined) {
  robotDirectives.push(`max-video-preview:${robots.maxVideoPreview}`);
}

if (robotDirectives.length > 0) {
  metaTags.push({ name: "robots", content: robotDirectives.join(", ") });
}

// OpenGraph tags
if (openGraph) {
  const ogTitle = openGraph.title ?? computedTitle;
  const ogDescription = openGraph.description ?? description;
  const ogUrl =
    openGraph.url instanceof URL
      ? openGraph.url.href
      : (openGraph.url ?? (canonical instanceof URL ? canonical.href : canonical));

  if (ogTitle) metaTags.push({ property: "og:title", content: ogTitle });
  if (ogDescription)
    metaTags.push({ property: "og:description", content: ogDescription });
  if (openGraph.type)
    metaTags.push({ property: "og:type", content: openGraph.type });
  if (ogUrl) metaTags.push({ property: "og:url", content: String(ogUrl) });
  if (openGraph.siteName)
    metaTags.push({ property: "og:site_name", content: openGraph.siteName });
  if (openGraph.locale)
    metaTags.push({ property: "og:locale", content: openGraph.locale });

  if (openGraph.alternateLocales) {
    for (const altLocale of openGraph.alternateLocales) {
      metaTags.push({ property: "og:locale:alternate", content: altLocale });
    }
  }

  // Handle single and multiple images
  const ogImages: OpenGraphMedia[] = [];
  if (openGraph.image) {
    if (typeof openGraph.image === "string") {
      ogImages.push({ url: openGraph.image });
    } else {
      ogImages.push(openGraph.image);
    }
  }
  if (openGraph.images) {
    for (const img of openGraph.images) {
      if (typeof img === "string") {
        ogImages.push({ url: img });
      } else {
        ogImages.push(img);
      }
    }
  }

  for (const img of ogImages) {
    metaTags.push({ property: "og:image", content: img.url });
    if (img.alt) metaTags.push({ property: "og:image:alt", content: img.alt });
    if (img.width)
      metaTags.push({
        property: "og:image:width",
        content: String(img.width),
      });
    if (img.height)
      metaTags.push({
        property: "og:image:height",
        content: String(img.height),
      });
    if (img.type)
      metaTags.push({ property: "og:image:type", content: img.type });
    if (img.secureUrl)
      metaTags.push({
        property: "og:image:secure_url",
        content: img.secureUrl,
      });
  }

  // Article tags
  if (openGraph.article) {
    const art = openGraph.article;
    if (art.publishedTime) {
      metaTags.push({
        property: "article:published_time",
        content: art.publishedTime,
      });
    }
    if (art.modifiedTime) {
      metaTags.push({
        property: "article:modified_time",
        content: art.modifiedTime,
      });
    }
    if (art.expirationTime) {
      metaTags.push({
        property: "article:expiration_time",
        content: art.expirationTime,
      });
    }
    if (art.section) {
      metaTags.push({ property: "article:section", content: art.section });
    }
    if (art.authors) {
      for (const author of art.authors) {
        metaTags.push({ property: "article:author", content: author });
      }
    }
    if (art.tags) {
      for (const tag of art.tags) {
        metaTags.push({ property: "article:tag", content: tag });
      }
    }
  }
}

// Twitter tags
if (twitter) {
  const twTitle = twitter.title ?? computedTitle;
  const twDescription = twitter.description ?? description;
  const twUrl =
    twitter.url instanceof URL
      ? twitter.url.href
      : (twitter.url ?? (canonical instanceof URL ? canonical.href : canonical));

  if (twitter.card)
    metaTags.push({ name: "twitter:card", content: twitter.card });
  if (twitter.site)
    metaTags.push({ name: "twitter:site", content: twitter.site });
  if (twitter.creator)
    metaTags.push({ name: "twitter:creator", content: twitter.creator });
  if (twTitle) metaTags.push({ name: "twitter:title", content: twTitle });
  if (twDescription)
    metaTags.push({ name: "twitter:description", content: twDescription });
  if (twitter.image)
    metaTags.push({ name: "twitter:image", content: twitter.image });
  if (twitter.imageAlt)
    metaTags.push({ name: "twitter:image:alt", content: twitter.imageAlt });
  if (twUrl) metaTags.push({ name: "twitter:url", content: String(twUrl) });
}

// Additional meta tags
metaTags.push(...additionalMetaTags);

// Canonical link tag
const canonicalHref =
  canonical instanceof URL ? canonical.href : canonical ? String(canonical) : null;

const linkTags: LinkTag[] = [
  ...(canonicalHref ? [{ rel: "canonical", href: canonicalHref }] : []),
  ...additionalLinkTags,
];

// JSON-LD safe string serialization
const jsonLdScript = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : "";
---

{computedTitle && <title>{computedTitle}</title>}

{
  metaTags.map((tag) => {
    if (tag.name) {
      return <meta name={tag.name} content={tag.content} />;
    }
    if (tag.property) {
      return <meta property={tag.property} content={tag.content} />;
    }
    if (tag.httpEquiv) {
      return <meta http-equiv={tag.httpEquiv} content={tag.content} />;
    }
    return null;
  })
}

{linkTags.map((tag) => <link {...tag} />)}

{
  jsonLdScript && (
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLdScript}
    />
  )
}
