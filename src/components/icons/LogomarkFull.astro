---
import { Icon } from "astro-icon/components";

export interface Props {
  size?: number | string;
  width?: number | string;
  height?: number | string;
  class?: string;
}

const {
  size = 48,
  width = size,
  height = size,
  class: className = "",
  ...props
} = Astro.props;
---

<Icon
  name="logomark-full"
  width={width}
  height={height}
  class={className}
  aria-hidden="true"
  {...props}
/>
