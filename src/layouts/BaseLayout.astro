---
import "../styles/tailwind.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import type { Props as SeoProps } from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  permalink?: string;
  current?: string;
  hideFooter?: boolean;
  ogImage?: string;
  article?: ArticleMeta;
  seo?: Partial<SeoProps>;
}

const {
  title,
  description,
  permalink,
  current,
  hideFooter = false,
  ogImage,
  article,
  seo,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      permalink={permalink}
      ogImage={ogImage}
      article={article}
      seo={seo}
    />
  </head>
  <body class="bg-background-body text-text-main font-serif antialiased min-h-screen">
    <div class="flex flex-col min-h-screen">
      <Header current={current} />

      <main
        class="flex-1 relative mx-auto max-w-5xl px-6 py-6 box-border w-full flex flex-col"
      >
        <slot />
      </main>

      {!hideFooter && (
        <div class="mx-auto max-w-5xl px-6 w-full">
          <Footer />
        </div>
      )}
    </div>
  </body>
</html>
