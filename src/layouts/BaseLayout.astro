---
import "../styles/tailwind.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  permalink?: string;
  current?: string;
  hideFooter?: boolean;
  ogImage?: string;
  article?: ArticleMeta;
}
const {
  title,
  description,
  permalink,
  current,
  hideFooter = false,
  ogImage,
  article,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      permalink={permalink}
      ogImage={ogImage}
      article={article}
    />
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header current={current} />

      <main
        class="flex-1 relative mx-auto max-w-[1400px] py-4 px-8 max-sm:px-4 box-border w-full flex flex-col"
      >
        <slot />
      </main>

      {!hideFooter && <Footer />}
    </div>
  </body>
</html>
