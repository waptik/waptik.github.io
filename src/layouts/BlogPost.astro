---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Bio from "../components/Bio.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostNav from "../components/PostNav.astro";
import RecentPostsWidget from "../components/RecentPostsWidget.astro";
import Search from "../components/Search.astro";
import { BLOG } from "../config";
import { tagSlug, type Post } from "../utils/posts";
import { formatDate } from "../utils/date";

export interface Props {
  title: string;
  description: string;
  permalink: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: string;
  headings?: MarkdownHeading[];
  previous?: Post;
  next?: Post;
  ogImage?: string;
  relatedPosts?: Post[];
}

const {
  title,
  description,
  permalink,
  pubDate,
  updatedDate,
  tags = [],
  readingTime,
  headings = [],
  previous,
  next,
  ogImage,
  relatedPosts = [],
} = Astro.props;

const hasToc =
  BLOG.showTableOfContents &&
  headings.filter((h) => h.depth >= 2 && h.depth <= 3).length >=
    BLOG.tocMinHeadings;

const hasSidebar = true;
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="blog"
  hideFooter={false}
  ogImage={ogImage}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate?.toISOString(),
    tags: tags ?? [],
  }}
>
  <header class="text-center max-w-3xl mx-auto mb-8">
    <p class="uppercase font-sans font-semibold text-text-secondary text-sm">
      {formatDate(pubDate)}
      {readingTime && ` ~ ${readingTime}`}
      {updatedDate && ` (Updated: ${formatDate(updatedDate)})`}
    </p>
    <h1 class="font-serif font-bold text-3xl sm:text-5xl mt-2 mb-4">
      {title}
    </h1>

    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2 mt-4">
          {tags.map((tag) => (
            <a
              href={`/tags/${tagSlug(tag)}/`}
              class="tag-chip font-sans text-xs px-2.5 py-1 rounded-full border border-primary/30 text-primary hover:bg-primary hover:text-white transition-colors no-underline shadow-none"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <hr class="min-w-[100px] w-[30%] mx-auto mt-6" />
  </header>

  <div class="w-full">
    <div
      class={
        hasSidebar
          ? "flex flex-col lg:flex-row gap-8 lg:gap-12"
          : "max-w-[42em] mx-auto"
      }
    >
      <div class="flex-1 min-w-0">
        {
          hasToc && (
            <div class="block lg:hidden mb-8 p-4 rounded-lg bg-text-secondary/5 border border-text-secondary/20">
              <TableOfContents headings={headings} />
            </div>
          )
        }

        <article class="content" data-pagefind-body>
          <slot />
        </article>

        <PostNav previous={previous} next={next} />

        <Bio />

        {
          relatedPosts.length > 0 && (
            <div class="block lg:hidden my-8 pt-6 border-t border-border">
              <RecentPostsWidget
                posts={relatedPosts}
                title="Related Posts"
                limit={3}
              />
            </div>
          )
        }

      </div>

      {
        hasSidebar && (
          <aside
            class="w-full lg:w-72 shrink-0 self-stretch pt-8 border-t border-border lg:pt-0 lg:border-t-0 lg:border-l lg:border-border lg:pl-8 xl:pl-12"
            aria-label="Sidebar"
          >
            <div class="sticky top-8 flex flex-col gap-8">
              <Search />
              {hasToc && <TableOfContents headings={headings} />}
              {relatedPosts.length > 0 && (
                <div class={hasToc ? "pt-6 border-t border-border" : ""}>
                  <RecentPostsWidget
                    posts={relatedPosts}
                    title="Related Posts"
                    limit={3}
                  />
                </div>
              )}
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
