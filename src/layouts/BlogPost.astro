---
import BaseLayout from "./BaseLayout.astro";
import Bio from "../components/Bio.astro";
import { AUTHOR, SOCIAL, SITE } from "../config";

const today = new Date();

export interface Props {
  title: string;
  description: string;
  permalink: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: string;
}

const { title, description, permalink, pubDate, updatedDate, tags, readingTime } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="blog"
  hideFooter={true}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate?.toISOString(),
    tags: tags ?? [],
  }}
>
  <header class="text-center">
    <p class="uppercase font-sans font-semibold text-text-secondary">
      {pubDate.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" })}
      {readingTime && ` ~ ${readingTime}`}
      {updatedDate && ` (Updated ${updatedDate.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" })})`}
    </p>
    <h1 class="mb-4">{title}</h1>
    <hr class="min-w-[100px] w-[30%] mx-auto" />
  </header>
  <div class="container">
    <article class="content">
      <slot />
    </article>
    <hr />
    <Bio />
    <footer class="blog-post-footer mt-12 pt-8 border-t border-text-secondary">
      <div class="footer-content grid grid-cols-3 gap-8 mb-8 max-md:grid-cols-1 max-md:gap-6">
        <div class="footer-section">
          <h3 class="text-base mb-4 text-text-main">
            Let's Connect
          </h3>
          <div class="footer-links flex flex-col gap-2">
            {
              SOCIAL.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="no-underline transition-colors duration-200 text-text-secondary hover:text-primary"
                >
                  {social.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="footer-section">
          <h3 class="text-base mb-4 text-text-main">
            Site Links
          </h3>
          <div class="footer-links flex flex-col gap-2">
            <a
              href="/rss.xml"
              class="no-underline transition-colors duration-200 text-text-secondary hover:text-primary"
            >RSS Feed</a>
            <a
              href="/sitemap.xml"
              class="no-underline transition-colors duration-200 text-text-secondary hover:text-primary"
            >Sitemap</a>
          </div>
        </div>

        <div class="footer-section">
          <h3 class="text-base mb-4 text-text-main">
            About
          </h3>
          <p class="text-sm leading-relaxed text-text-secondary">
            {AUTHOR.bio}
          </p>
        </div>
      </div>

      <div class="footer-bottom flex justify-between items-center pt-8 border-t border-text-secondary max-md:flex-col max-md:gap-4 max-md:text-center">
        <p class="m-0 text-sm text-text-secondary">
          &copy; {today.getFullYear()} {SITE.title}. All rights reserved. Powered by <a href="https://astro.build" target="_blank" rel="noopener" class="underline shadow-none hover:text-primary">Astro</a>.
        </p>
        <button
          id="back-to-top"
          aria-label="Back to top"
          class="text-white border-none w-10 h-10 rounded-full cursor-pointer text-xl transition-colors duration-200 bg-primary hover:bg-text-main"
        >
          ↑
        </button>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  const backToTop = document.getElementById("back-to-top");
  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5em;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1em;
      text-align: center;
    }
  }
</style>
