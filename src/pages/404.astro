---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page Not Found";
const description = "The page you are looking for does not exist or has been moved.";
---

<BaseLayout title={title} description={description}>
  <div class="container max-w-[42em] mx-auto text-center py-16 sm:py-24">
    <p class="font-mono text-sm uppercase tracking-widest text-primary mb-2">
      404 Error
    </p>
    <h1 class="font-serif font-bold text-5xl sm:text-6xl mb-4">
      Page Not Found
    </h1>
    <p class="text-text-secondary text-xl max-w-md mx-auto mb-8 leading-relaxed">
      Sorry, the page you're looking for doesn't exist or has moved somewhere else.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 font-sans font-semibold uppercase text-sm">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg bg-primary text-white dark:bg-text-main dark:text-background-body hover:bg-primary/90 dark:hover:bg-text-main/90 transition-colors no-underline shadow-none"
      >
        Go Home
      </a>
      <a
        href="/blog"
        class="px-5 py-2.5 rounded-lg border border-text-secondary/30 text-text-main hover:text-primary hover:border-primary transition-colors no-underline shadow-none"
      >
        View All Posts
      </a>
    </div>
  </div>
</BaseLayout>
