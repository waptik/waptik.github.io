---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, AUTHOR } from "../config";

const title = "About";
const description = `About ${AUTHOR.name}`;
const permalink = Astro.site ? `${Astro.site.href}about` : "/about";
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="about"
>
  <div class="container">
    <h1>About</h1>
    <figure class="about-image">
      <img src={AUTHOR.avatar} alt={AUTHOR.name} width="330" height="330" />
    </figure>
    <p>
      Hi! I'm {AUTHOR.name}, {AUTHOR.bio}
    </p>
    <p>
      This site serves as both my portfolio and blog where I share my thoughts,
      tutorials, and insights from my journey in tech.
    </p>
    <p>
      Feel free to reach out through any of the social platforms linked in the
      footer, or check out my latest posts on the blog.
    </p>
  </div>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    aspect-ratio: 1/1;
    margin-bottom: 1.5em;
  }

  @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
