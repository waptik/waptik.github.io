---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, AUTHOR } from "../config";

const title = "About";
const description = `About ${AUTHOR.name}`;
const permalink = Astro.site ? `${Astro.site.href}about` : "/about";
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="about"
>
  <div class="container">
    <h1>About</h1>
    <figure
      class="float-right max-w-[300px] -mt-12 -mr-28 mb-8 ml-8 max-[1020px]:float-none max-[1020px]:my-0 max-[1020px]:mx-auto max-[1020px]:mb-8"
    >
      <img
        src={AUTHOR.avatar}
        alt={AUTHOR.name}
        width="330"
        height="330"
        class="rounded-full object-cover object-top aspect-square mb-6"
      />
    </figure>
    <p>
      Hi! I'm {AUTHOR.name}, {AUTHOR.bio}
    </p>
    <p>
      This site serves as both my portfolio and blog where I share my thoughts,
      tutorials, and insights from my journey in tech.
    </p>
    <p>
      Feel free to reach out through any of the social platforms linked in the
      footer, or check out my latest posts on the blog.
    </p>
  </div>
</BaseLayout>
