---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { OG } from "../../config";
import {
  getPublishedPosts,
  getAdjacentPosts,
  type Post,
} from "../../utils/posts";
import { readingTime } from "../../utils/reading-time";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      ...getAdjacentPosts(posts, post.id),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const permalink = Astro.site
  ? `${Astro.site.href}blog/${post.id}/`
  : `/blog/${post.id}/`;
const minutes = readingTime(post.body);
const readingTimeEstimate = `${minutes} min read`;
const ogImage = OG.enabled ? `/og/${post.id}.png` : undefined;
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  permalink={permalink}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  readingTime={readingTimeEstimate}
  headings={headings}
  previous={previous}
  next={next}
  ogImage={ogImage}
>
  <Content />
</BlogPost>
