---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const title = SITE.title;
const description = SITE.description;
const permalink = Astro.site?.href || "/";
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div
    class="flex flex-col min-[801px]:flex-row flex-1 items-center justify-center my-8 min-h-[400px]"
  >
    <div
      class="px-4 text-center min-[801px]:text-left flex-none min-[801px]:flex-1 pb-8 min-[801px]:pb-0"
    >
      <h1 class="font-serif font-bold text-5xl sm:text-6xl mb-2 leading-tight">
        Welcome to my website
      </h1>
      <p class="text-2xl max-[1200px]:text-xl my-4 leading-relaxed">
        {SITE.tagline}
      </p>
    </div>

    <div class="mx-4 text-center shrink-0">
      <picture class="block min-h-[250px]">
        <source
          srcset="/assets/home-illustration.webp"
          media="(min-width: 600px)"
        />
        <img
          class="w-full max-w-[550px] max-[1200px]:max-w-[400px] mb-4"
          alt="Illustration of person reading a book"
          src="/assets/home-illustration-small.webp"
          width="550"
          height="466"
        />
      </picture>
      <p class="text-xs italic text-left">
        Illustration by{" "}
        <a
          href="https://icons8.com/illustrations/author/5c07e68d82bcbc0092519bb6"
          target="_blank"
          rel="noopener">Icons 8</a>{" "}
        from{" "}
        <a
          href="https://icons8.com/illustrations"
          target="_blank"
          rel="noopener">Ouch!</a>
      </p>
    </div>
  </div>
</BaseLayout>
