---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, collectTags } from "../../utils/posts";

const posts = await getPublishedPosts();
const tags = collectTags(posts);
const title = "Tags";
const description = `Browse all ${tags.length} topics covered on the blog.`;
const permalink = Astro.site ? `${Astro.site.href}tags` : "/tags";
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="tags"
>
  <div class="container max-w-[42em] mx-auto">
    <div class="mb-10">
      <h1 class="font-serif font-bold text-4xl sm:text-5xl mb-3">Tags</h1>
      <p class="text-text-secondary text-lg">
        Explore {tags.length} {tags.length === 1 ? "topic" : "topics"} across {posts.length} {posts.length === 1 ? "post" : "posts"}.
      </p>
    </div>

    {
      tags.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag.slug}/`}
              class="group flex items-center justify-between p-5 rounded-lg border border-text-secondary/20 hover:border-primary transition-all no-underline shadow-none"
            >
              <span class="font-sans font-bold text-lg text-text-main group-hover:text-primary transition-colors">
                #{tag.name}
              </span>
              <span class="font-mono text-xs font-semibold px-2.5 py-1 rounded bg-text-secondary/10 text-text-secondary">
                {tag.count} {tag.count === 1 ? "post" : "posts"}
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-text-secondary">No tags found yet.</p>
      )
    }
  </div>
</BaseLayout>
